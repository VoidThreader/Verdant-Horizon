#the mod name as displayed in-game
displayName: "Verdant Horizon"

#the internal name of your mod
name: "verdant"

#your name
author: "VoidThreader"

#the fully qualified main class of the mod
main: "verdant.VerdantHorizonMod"

#the mod description as seen in the mod dialog
description: "A Java Mindustry mod that aims to expand the base game."
subtitle: "Welcome to Verdania."

#the mod version
version: 0.0.1

#the minimum game build required to run this mod
minGameVersion: 160.3

#this is a java mod
java: true
